# Скопируйте в deploy/.env и поменяйте пароль базы перед развёртыванием на сервере.
POSTGRES_USER=vmeste
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vmeste
DB_HOST_PORT=5433
HTTP_PORT=8080

# true, когда сайт открыт по HTTPS: cookie сессии уходит только по защищённому соединению.
COOKIE_SECURE=false
DEMO_LOGIN_ENABLED=false

# Адрес сайта для ссылок в превью соцсетей, sitemap.xml и robots.txt, например https://sport.example.ru.
# Пусто — адрес берётся из запроса (X-Forwarded-Proto и Host).
SITE_URL=

# Доменные правила и демо-данные.
# Пустая база при старте — загрузить демо-данные; новая версия демо-данных вливается в базу, люди и их записи
# остаются; новый календарный день — сдвинуть даты демо-записей (записи людей не сдвигаются).
DEMO_SEED_ON_START=true
DEMO_SHIFT_DATES=true
# Сброс демо-данных кнопкой и запросом POST /api/demo/reset (и переключатель сбоя помощника).
# Сброс стирает всех зарегистрированных людей и всё, что они создали, в том числе записи об оплате.
# На публичном сервере ставьте false: тогда эти запросы отвечают 404. true — разработка и сценарии запросов.
DEMO_RESET_ENABLED=true
# Куда сохранять снимок записей людей перед обновлением демо-данных до новой версии (хранятся последние 20).
# В docker-compose.yml это том domain-backups. Пусто — снимки не сохраняются.
DOMAIN_BACKUP_DIR=/backups
# Как часто проверять истёкшие резервы, напоминания и места команд, секунд.
DOMAIN_TICK_SECONDS=15

# Помощник: fake (на правилах, без ключа) | gigachat | yandexgpt | off
AI_PROVIDER=fake
AI_TIMEOUT_SECONDS=8
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Путь внутри контейнера к корневому сертификату НУЦ Минцифры (смонтируйте файл томом).
GIGACHAT_CA_BUNDLE=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ---------- Почта: подтверждение адреса и сброс пароля ----------
# true — письма уходят через SMTP; false — тема и ссылка пишутся в журнал бэкенда (письма никуда не уходят).
MAIL_ENABLED=false
# true — после регистрации сначала письмо со ссылкой, войти можно только после перехода по ней.
# Работает только вместе с MAIL_ENABLED=true, иначе письмо до человека не дойдёт.
EMAIL_VERIFICATION=false
# Сервер отправки. По умолчанию — сервис mail из docker-compose.yml (внутри сети, без пароля и TLS).
SMTP_HOST=mail
SMTP_PORT=587
# Логин и пароль внешнего SMTP (например, почты на своём домене). Пусто — без входа.
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS после подключения (обычно порт 587) или сразу TLS (порт 465). Для сервиса mail — оба false.
SMTP_STARTTLS=false
SMTP_SSL=false
# Отправитель: домен адреса должен совпадать с MAIL_DOMAIN, иначе mail откажет в отправке.
MAIL_FROM=Спорт и точка <noreply@sport.up-point.tech>
# Куда придёт ответ на письмо. Пусто — ответ уйдёт на адрес отправителя.
MAIL_REPLY_TO=

# ---------- SMS: код подтверждения, если письмо не дошло ----------
# Работает вместе с EMAIL_VERIFICATION=true. log — код пишется в журнал бэкенда (SMS не уходят),
# smsaero — отправка через SMS Aero (нужны почта кабинета и API-ключ).
SMS_PROVIDER=log
# Почта, под которой зарегистрирован кабинет SMS Aero.
SMSAERO_EMAIL=
# API-ключ из кабинета SMS Aero (Настройки → API). Только в deploy/.env на сервере, не в репозитории.
SMSAERO_API_KEY=
# Подпись отправителя. Пусто — «SMS Aero» (бесплатная, для проверки); для работы — своя из кабинета.
SMSAERO_SIGN=
# Не больше стольких SMS в сутки на весь сайт (защита бюджета).
SMS_DAILY_LIMIT=100
# Секрет для хешей кодов (длинная случайная строка, например openssl rand -hex 32).
# Пусто — случайный на время работы процесса: коды, выданные до перезапуска, перестанут подходить.
SMS_CODE_PEPPER=

# Сервис mail (Postfix). Домен отправителя и имя сервера в приветствии SMTP (должно совпадать с PTR-записью IP).
MAIL_DOMAIN=sport.up-point.tech
MAIL_HOSTNAME=sport.up-point.tech
# Папка с ключом DKIM <домен>.private (селектор mail). Пусто — ./dkim рядом с docker-compose.yml;
# без ключа письма уходят без подписи. На сервере: /srv/sport-mail/dkim
MAIL_DKIM_DIR=./dkim

# ---------- ВКонтакте: заполнить профиль по ссылке на страницу ----------
# Сервисный ключ приложения: dev.vk.com → «Мои приложения» → создать (веб) → «Ключи доступа» → сервисный.
VK_SERVICE_TOKEN=

# ---------- Боты Telegram и VK: привязка аккаунта ----------
# Общий секрет бота и сайта (длинная случайная строка, например openssl rand -hex 32).
# Бот подписывает им запросы привязки (заголовок X-Bot-Secret). Пусто — привязка выключена.
BOT_API_SECRET=
# Ник Telegram-бота без @ (например sport_i_tochka_bot). Пусто — на сайте только код, без ссылки t.me.
TELEGRAM_BOT_USERNAME=
# Номер сообщества VK для ссылки vk.me/club<номер>.
VK_GROUP_ID=242415813

# ---------- VK-бот сообщества (сервис vk-bot) ----------
# Ключ сообщества: «Управление → Работа с API → Ключи доступа», права «сообщения сообщества», «фотографии»,
# «управление сообществом». Задаётся скриптом scripts/set-vk-bot-token.ps1. Пусто — бот выключен и спит.
VK_GROUP_TOKEN=
# Ключ шифрования личных ключей людей в базе бота (Fernet, 44 символа). Скрипт создаёт его сам.
# Не меняйте после запуска: подключённым людям придётся подключать бота заново.
BOT_STORE_KEY=
# Как часто бот проверяет новые уведомления, секунд.
NOTIFY_INTERVAL=30

# ---------- Уведомления в браузер (Web Push) ----------
# Пара ключей VAPID: python scripts/generate-vapid-keys.py печатает обе строки для этого файла.
# Ключи не меняйте после запуска: старые подписки браузеров перестанут работать. Пусто — канал выключен.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Контакт владельца сайта для служб push-уведомлений браузеров (mailto: или https:).
WEB_PUSH_SUBJECT=mailto:noreply@sport.up-point.tech

# ---------- Оплата на сайте (ЮKassa) ----------
# fake — встроенная тестовая страница оплаты без списания денег; yookassa — настоящий шлюз.
PAYMENTS_PROVIDER=disabled
PAYMENTS_ENABLED=false
# Магазин ЮKassa: «Интеграция → Ключи API». Ключ test_… — тестовый магазин.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# «Чеки от ЮKassa» (54-ФЗ): true — к платежу прикладывается чек. Система налогообложения 1–6, НДС: 1 — без НДС.
YOOKASSA_RECEIPTS=false
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_VAT_CODE=1
# Шлюз «Выплаты» (отдельный договор). Пусто — выплаты переводит администратор и отмечает «Переведено».
YOOKASSA_PAYOUT_AGENT_ID=
YOOKASSA_PAYOUT_SECRET_KEY=
# Принимать уведомления только с адресов ЮKassa. Включайте, если nginx передаёт настоящий адрес (X-Real-IP).
YOOKASSA_CHECK_IP=false
