# Скопируйте в backend/.env для локального запуска. Все параметры — в app/core/config.py.
APP_ENV=dev
LOG_LEVEL=INFO

# База из deploy/docker-compose.yml (порт 5433 на localhost).
DATABASE_URL=postgresql+asyncpg://vmeste:vmeste@localhost:5433/vmeste
# Тесты создают и пересоздают эту базу сами.
TEST_DATABASE_URL=postgresql+asyncpg://vmeste:vmeste@localhost:5433/vmeste_test

# Для запуска фронтенда на другом порту без прокси, через запятую.
CORS_ORIGINS=

SESSION_COOKIE_NAME=vmeste_session
SESSION_TTL_HOURS=336
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEMO_LOGIN_ENABLED=true

# Доменные правила и демо-данные.
# Пустая база при старте — загрузить демо-данные; новый календарный день — сдвинуть даты демо-данных.
DEMO_SEED_ON_START=true
DEMO_SHIFT_DATES=true
# Как часто проверять истёкшие резервы, напоминания и места команд, секунд.
DOMAIN_TICK_SECONDS=15
# Поле записи без колонки в таблице — ошибка (для разработки и тестов).
DOMAIN_STRICT=true

SSE_HEARTBEAT_SECONDS=15
SSE_RETRY_MS=3000
SSE_REPLAY_SIZE=1000

# Помощник: fake | gigachat | yandexgpt | off
AI_PROVIDER=fake
AI_TIMEOUT_SECONDS=8
AI_CACHE_TTL_SECONDS=600
AI_USER_LIMIT_PER_MINUTE=10
AI_USER_LIMIT_PER_DAY=200
AI_MAX_INPUT_CHARS=2000
AI_EMBEDDING_DIM=256
# Учебный сбой фейкового провайдера: none | timeout | error | invalid
AI_FAKE_FAILURE=none
AI_FAKE_DELAY_MS=0

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=true

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# Почта. Выключена — тема и ссылка письма пишутся в журнал. Для проверки писем: профиль dev с mailpit
# (SMTP_HOST=localhost, SMTP_PORT=1025, письма — на http://127.0.0.1:8025).
MAIL_ENABLED=false
EMAIL_VERIFICATION=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=Спорт и точка <noreply@sport.up-point.tech>
MAIL_REPLY_TO=
